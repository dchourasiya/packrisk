table dim_policy
	lineageTag: 42400f43-89c9-4584-90f5-637a0d8ecdce

	column policy_id
		dataType: string
		lineageTag: 26d505d9-990f-4f75-9354-9ac0d48e8c7f
		summarizeBy: none
		sourceColumn: policy_id

		annotation SummarizationSetBy = Automatic

	column name
		dataType: string
		lineageTag: 59554eb2-2c52-40f0-86c1-45641c2af496
		summarizeBy: none
		sourceColumn: name
		sortByColumn: sort

		annotation SummarizationSetBy = Automatic

	column description
		dataType: string
		lineageTag: 9242fee5-04ea-4062-a79a-3186a5419e1b
		summarizeBy: none
		sourceColumn: description

		annotation SummarizationSetBy = Automatic

	column sort
		dataType: int64
		formatString: 0
		lineageTag: 60946695-cd6a-4334-a4f3-99cd1d61f848
		summarizeBy: none
		sourceColumn: sort

		annotation SummarizationSetBy = Automatic

	column plain_name
		dataType: string
		lineageTag: a38ccab0-8723-4c40-bade-f8b32c516b9a
		summarizeBy: none
		sourceColumn: plain_name
		sortByColumn: sort

		annotation SummarizationSetBy = Automatic

	partition dim_policy = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_policy.csv"), [Delimiter = ",", Columns = 4, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"policy_id", type text}, {"name", type text}, {"description", type text}, {"sort", Int64.Type}}, "en-US"),
				    Plain = Table.AddColumn(Typed, "plain_name", each Record.FieldOrDefault([
				        P1 = "Do nothing", P2 = "Fix worst suppliers first", P3 = "Fix lowest-stock parts first",
				        P4 = "Plan for average delays", P5 = "Smart plan (stochastic)", P6 = "Smart plan + worst-case guard",
				        P7 = "Perfect foresight (benchmark)"], [policy_id], [name]), type text)
				in
				    Plain

	annotation PBI_ResultType = Table
