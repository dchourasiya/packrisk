	partition fact_penalty_sensitivity = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_penalty_sensitivity.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"penalty_per_lost_pack", type number}, {"scenario_id", type text}, {"policy_id", type text}, {"mean_lost_packs", type number}, {"p90_lost_packs", type number}, {"mitigation_cost", type number}, {"mean_objective", type number}}, "en-US"),
				    Labeled = Table.AddColumn(Typed, "penalty_label", each "$" & Number.ToText([penalty_per_lost_pack] / 1000, "0") & "K", type text)
				in
				    Labeled

	annotation PBI_ResultType = Table
