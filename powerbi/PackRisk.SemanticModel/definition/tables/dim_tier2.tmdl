table dim_tier2
	lineageTag: 26b5f32a-5df6-40d2-8cbc-e07fb47621f5

	column tier2_id
		dataType: string
		lineageTag: e1e6fd16-97da-47ba-8c67-7d7765f5c34f
		summarizeBy: none
		sourceColumn: tier2_id

		annotation SummarizationSetBy = Automatic

	column shared_input
		dataType: string
