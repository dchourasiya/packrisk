				    Source = Csv.Document(File.Contents(DataFolder & "dim_tier2.csv"), [Delimiter = ",", Columns = 2, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"tier2_id", type text}, {"shared_input", type text}}, "en-US")
