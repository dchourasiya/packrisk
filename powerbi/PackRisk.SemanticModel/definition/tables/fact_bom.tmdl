table fact_bom
	lineageTag: 06bb3725-1ad0-449d-8f05-33deaae12c3f

	column component_id
		dataType: string
		lineageTag: c911670b-cff9-4bda-b9c0-34080b6fdf74
		summarizeBy: none
		sourceColumn: component_id

		annotation SummarizationSetBy = Automatic

	column variant
		dataType: string
		lineageTag: 42e05bb3-7e77-4a22-a377-478e50deb6c1
		summarizeBy: none
		sourceColumn: variant

		annotation SummarizationSetBy = Automatic

	column qty_per_pack
		dataType: double
		lineageTag: 452f47fe-31d9-4951-8bcd-e3362b98d923
		summarizeBy: sum
		sourceColumn: qty_per_pack

		annotation SummarizationSetBy = Automatic

	partition fact_bom = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_bom.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"component_id", type text}, {"variant", type text}, {"qty_per_pack", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
