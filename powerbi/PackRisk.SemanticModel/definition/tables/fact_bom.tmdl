table fact_bom
	lineageTag: 82a3c881-ed21-4ce6-b568-70702010dfb7

	column component_id
		dataType: string
		lineageTag: 7b2b9d8a-2fd8-4d6b-892d-2083abedb33c
		summarizeBy: none
		sourceColumn: component_id

		annotation SummarizationSetBy = Automatic

	column variant
		dataType: string
		lineageTag: 292cdf10-520c-4a0b-8a98-11f0945ca465
		summarizeBy: none
		sourceColumn: variant

		annotation SummarizationSetBy = Automatic

	column qty_per_pack
		dataType: double
		lineageTag: 0d92d766-7386-4b0e-8812-e220164c91d3
		summarizeBy: sum
		sourceColumn: qty_per_pack

		annotation SummarizationSetBy = Automatic

	partition fact_bom = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_bom.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"component_id", type text}, {"variant", type text}, {"qty_per_pack", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
