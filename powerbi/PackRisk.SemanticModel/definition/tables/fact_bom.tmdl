table fact_bom
	lineageTag: 48549b8c-a13f-4bc6-9f49-afe006d40eb5

	column component_id
		dataType: string
		lineageTag: db4fbbc1-056e-4180-9751-46c781d74f93
		summarizeBy: none
		sourceColumn: component_id

		annotation SummarizationSetBy = Automatic

	column variant
		dataType: string
		lineageTag: c35354ea-7ae6-4cf4-9d99-afb8fe578e34
		summarizeBy: none
		sourceColumn: variant

		annotation SummarizationSetBy = Automatic

	column qty_per_pack
		dataType: double
		lineageTag: 9263bc8f-4c30-471c-af78-82fe69335bae
		summarizeBy: sum
		sourceColumn: qty_per_pack

		annotation SummarizationSetBy = Automatic

	partition fact_bom = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_bom.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"component_id", type text}, {"variant", type text}, {"qty_per_pack", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
