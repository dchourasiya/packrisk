table fact_bom
	lineageTag: edc5f868-e9fe-42c5-86df-8bf077e2c9c7

	column component_id
		dataType: string
		lineageTag: 8874cc41-d069-4f3a-9c91-a9e68bf69067
		summarizeBy: none
		sourceColumn: component_id

		annotation SummarizationSetBy = Automatic

	column variant
		dataType: string
		lineageTag: 1b5405a8-64ec-4995-8162-2cee4defbeba
		summarizeBy: none
		sourceColumn: variant

		annotation SummarizationSetBy = Automatic

	column qty_per_pack
		dataType: double
		lineageTag: 2b399245-7b75-4a38-8bc1-dfc894af8fdc
		summarizeBy: sum
		sourceColumn: qty_per_pack

		annotation SummarizationSetBy = Automatic

	partition fact_bom = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_bom.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"component_id", type text}, {"variant", type text}, {"qty_per_pack", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
