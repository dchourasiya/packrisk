table fact_bom
	lineageTag: aedb7f1d-a393-4371-887e-e30bd77e6d68

	column component_id
		dataType: string
		lineageTag: 0822e98c-a133-4e4d-ba37-fb36c55f545b
		summarizeBy: none
		sourceColumn: component_id

		annotation SummarizationSetBy = Automatic

	column variant
		dataType: string
		lineageTag: 547f4862-8a67-4460-bf72-3a725c1da3e7
		summarizeBy: none
		sourceColumn: variant

		annotation SummarizationSetBy = Automatic

	column qty_per_pack
		dataType: double
		lineageTag: a1deaec6-c1d1-4ddc-a14d-cf794b64da9a
		summarizeBy: sum
		sourceColumn: qty_per_pack

		annotation SummarizationSetBy = Automatic

	partition fact_bom = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_bom.csv"), [Delimiter = ",", Columns = 3, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"component_id", type text}, {"variant", type text}, {"qty_per_pack", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table
