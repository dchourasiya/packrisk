table _Measures
	lineageTag: e1ef7f4c-e1f6-46c3-84bc-8444ff2d6538

	measure 'Lost Packs (mean)' = AVERAGE ( fact_realization_results[lost_packs] )
		formatString: #,0
		lineageTag: cfaf49ae-6f5a-453b-9826-2b4fcfb59426

	measure 'Lost Packs (P90)' = PERCENTILEX.INC ( fact_realization_results, fact_realization_results[lost_packs], 0.9 )
		formatString: #,0
		lineageTag: 8a8c40bf-1577-4906-a1f7-5667ff78a9c7

	measure 'Plan Attainment' = DIVIDE ( SUM ( fact_realization_results[built_packs] ), SUM ( fact_realization_results[plan_packs] ) )
		formatString: 0.0%
		lineageTag: beb2ab91-4f32-42b4-b851-e70c3ed6a871

	measure 'Backlog Pack-Weeks' = AVERAGE ( fact_realization_results[backlog_pack_weeks] )
		formatString: #,0
		lineageTag: b0bc8db4-9160-46e2-a628-9e00aa01ca27

	measure 'Mitigation Spend' = AVERAGE ( fact_realization_results[mitigation_cost] )
		formatString: \$#,0
		lineageTag: 8518a677-193e-4a36-a65c-40be9a8dbdd7

	measure 'Expected Total Cost' = AVERAGE ( fact_realization_results[objective] )
		formatString: \$#,0
		lineageTag: 51f422ac-0c71-4945-9a5c-d58ea3ed3504

	measure 'Budget Used %' = DIVIDE ( [Mitigation Spend], 250000 )
		formatString: 0.0%
		lineageTag: d8bb9dd2-19fa-4c22-b3d8-0b8dc66fd570

	measure 'Packs Protected vs Do Nothing' =
			VAR base = CALCULATE ( [Lost Packs (mean)], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P1" )
			RETURN base - [Lost Packs (mean)]
		formatString: #,0
		lineageTag: 0f753f5c-a1c7-4df2-abdb-8f86e361f9cf

	measure 'Oracle Capture' =
			VAR base   = CALCULATE ( [Lost Packs (mean)], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P1" )
			VAR oracle = CALCULATE ( [Lost Packs (mean)], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P7" )
			RETURN DIVIDE ( base - [Lost Packs (mean)], base - oracle )
		formatString: 0.0%
		lineageTag: 2a16edce-728e-484d-ab26-5504dbf21578

	measure 'VSS ($)' =
			CALCULATE ( [Expected Total Cost], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P4" )
			    - CALCULATE ( [Expected Total Cost], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5" )
		formatString: \$#,0
		lineageTag: cb17901b-5220-4bee-bf75-12676efb06b2

	measure 'Shortfall vs Plan' = SUM ( fact_weekly_trace[cum_built] ) - SUM ( fact_weekly_trace[cum_plan] )
		formatString: #,0
		lineageTag: 3a9951db-9e93-4290-b1e5-5e28de027501

	measure 'Gated Share' = MAX ( fact_gating_component[share_of_realizations_gated] )
		formatString: 0%
		lineageTag: bf71670a-9303-4169-ae10-0e494d9d7032

	measure 'Weeks of Cover' = AVERAGE ( fact_inventory_trace[weeks_of_cover] )
		formatString: 0.0
		lineageTag: e547869d-b4f2-487d-ba2d-bbb443ae5082

	measure 'Action Spend' = SUM ( fact_actions[cost] )
		formatString: \$#,0
		lineageTag: bbe11f29-c4da-4ee6-8165-47556e6fe00d

	measure OTIF = AVERAGE ( dim_supplier[otif_rate] )
		formatString: 0.0%
		lineageTag: 089c5c27-0933-4fb3-b41f-1fff2e2ea668

	measure 'Simulated Label' = "Simulated data. Placeholder delay parameters."
		lineageTag: d7d4f193-f0fd-4665-bba1-1a9391aa282f

	measure 'Gating Frequency' = SUM ( fact_gating_frequency[share_of_realizations] )
		formatString: 0%
		lineageTag: ab998a7d-c0e0-423b-a425-575535486304

	measure 'Scenario Description' = SELECTEDVALUE ( dim_scenario[description], "Select one scenario in the slicer." )
		lineageTag: 7a010d38-bfa2-4ef3-9390-e8b55a6e7544

	measure 'Is Primary Supplier' = INT ( NOT ISEMPTY ( dim_component ) )
		formatString: 0
		lineageTag: 05e6d21f-9972-4b68-81ea-4cdc49912977

	measure 'Avg Late Rate' = AVERAGE ( dim_supplier[late_rate] )
		formatString: 0.0%
		lineageTag: 365fcbdb-7c3d-495d-9cfa-a3b0f626c0a3

	measure 'Suppliers Tracked' = COUNTROWS ( FILTER ( dim_supplier, NOT ISBLANK ( dim_supplier[otif_rate] ) ) )
		formatString: 0
		lineageTag: 6987182e-7c7b-4bb2-ada3-79d9e92f0821

	measure 'Single-Sourced Parts' = COUNTROWS ( FILTER ( dim_component, dim_component[single_sourced] ) )
		formatString: 0
		lineageTag: a553ca84-f91b-479f-9477-d6e657147b46

	measure 'Expected Cost Avoided' =
			VAR base = CALCULATE ( [Expected Total Cost], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P1" )
			RETURN base - [Expected Total Cost]
		formatString: \$#,0
		lineageTag: f1c5ea0d-8747-4e7b-bbdf-827f13d5fed8

	measure 'Return on Mitigation' = DIVIDE ( [Expected Cost Avoided], [Mitigation Spend] )
		formatString: 0.0"x"
		lineageTag: 7072c5fc-54d2-43a2-b8b9-b8cba960ae62

	measure Headline =
			VAR prot    = CALCULATE ( [Packs Protected vs Do Nothing], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5" )
			VAR avoided = CALCULATE ( [Expected Cost Avoided], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5" )
			VAR spend   = CALCULATE ( [Mitigation Spend], REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5" )
			VAR money   = IF ( avoided >= 1000000, FORMAT ( avoided / 1000000, "$0.0" ) & "M", FORMAT ( avoided / 1000, "$0" ) & "K" )
			VAR spendTx = IF ( spend >= 1000000, FORMAT ( spend / 1000000, "$0.0" ) & "M", FORMAT ( spend / 1000, "$0" ) & "K" )
			RETURN
			    IF (
			        HASONEVALUE ( dim_scenario[scenario_id] ),
			        "The smart plan protects " & FORMAT ( prot, "#,0" ) & " packs and saves " & money & " net"
			            & " for " & spendTx & " of fixes"
			            & IF ( spend > 0, " (" & FORMAT ( DIVIDE ( avoided, spend ), "0.0" ) & "x return).", "." ),
			        "Select one scenario to see the headline."
			    )
		lineageTag: 480c6977-1ffd-40ae-adff-72b6971d1e69

	measure 'Primary Supplier Late Rate' =
			VAR s = SELECTEDVALUE ( dim_component[primary_supplier_id] )
			RETURN IF ( NOT ISBLANK ( s ), LOOKUPVALUE ( dim_supplier[late_rate], dim_supplier[supplier_id], s ) )
		formatString: 0.0%
		lineageTag: 80c8643d-aedf-451b-a8f1-5a413fc9d5b3

	measure 'Primary Supplier Late Rank' =
			VAR r = [Primary Supplier Late Rate]
			RETURN IF ( NOT ISBLANK ( r ), COUNTROWS ( FILTER ( ALL ( dim_supplier ), dim_supplier[late_rate] > r ) ) + 1 )
		formatString: 0
		lineageTag: 63b08365-fcd6-4384-8267-2351ed1b48af

	measure 'Stops Line Share' = COALESCE ( [Gated Share], 0 )
		formatString: 0%
		lineageTag: df7bfb4b-c664-44b7-93ca-80c8ff8f5591

	measure 'Dependency Stops Line' =
			VAR depId = SELECTEDVALUE ( fact_shared_dependency[dependency_id] )
			RETURN COALESCE ( CALCULATE ( [Gated Share], FILTER ( ALL ( dim_component ), dim_component[lane_id] = depId || dim_component[tier2_id] = depId ) ), 0 )
		formatString: 0%
		lineageTag: dd7e031e-393d-4aa1-91af-975c7fb3cbd5

	measure 'Parts Stopping Line' = COUNTROWS ( FILTER ( VALUES ( dim_component[component_id] ), [Gated Share] > 0 ) ) + 0
		formatString: 0
		lineageTag: 77c66784-543a-469d-8585-433b9e065563

	measure 'Suppliers Stopping Line' = COUNTROWS ( FILTER ( VALUES ( dim_supplier[supplier_id] ), [Gated Share] > 0 ) ) + 0
		formatString: 0
		lineageTag: 5bb6cb7a-0ffa-4f65-87cc-8404da21ba7c

	measure 'Stopping Suppliers Late Rate' = AVERAGEX ( FILTER ( VALUES ( dim_supplier[supplier_id] ), [Gated Share] > 0 ), CALCULATE ( MAX ( dim_supplier[late_rate] ) ) )
		formatString: 0.0%
		lineageTag: 8fcb7da9-dd49-47df-8937-f1fcd67d2ed1

	measure 'Drill Component' = IF ( ISFILTERED ( dim_component[component_id] ) && HASONEVALUE ( dim_component[component_id] ), SELECTEDVALUE ( dim_component[name] ), "No part selected. On Scenario Explorer, right-click a part > Drill through." )
		lineageTag: c8356a92-9dad-441d-8330-471286fe3b06

	measure 'Component Selected' = INT ( ISFILTERED ( dim_component[component_id] ) && HASONEVALUE ( dim_component[component_id] ) )
		formatString: 0
		lineageTag: d29807a2-63e6-4922-a442-e54891f0261e

	measure 'Penalty Test Net Saving' =
			VAR doNothing = CALCULATE ( AVERAGE ( fact_penalty_sensitivity[mean_objective] ), REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P1" )
			VAR smart     = CALCULATE ( AVERAGE ( fact_penalty_sensitivity[mean_objective] ), REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5" )
			RETURN doNothing - smart
		formatString: \$#,0
		lineageTag: 3045a53f-d053-463c-807b-fc644ea3b9c1

	measure 'Held-out Wins' =
			VAR heldOut = CALCULATETABLE ( VALUES ( dim_scenario[scenario_id] ), REMOVEFILTERS ( dim_scenario ), dim_scenario[split] = "held-out" )
			VAR wins = COUNTROWS ( FILTER ( heldOut, VAR s = dim_scenario[scenario_id] RETURN CALCULATE ( [Expected Cost Avoided], REMOVEFILTERS ( dim_scenario ), dim_scenario[scenario_id] = s, REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5" ) > 0 ) )
			RETURN FORMAT ( wins, "0" ) & " of " & FORMAT ( COUNTROWS ( heldOut ), "0" )
		lineageTag: b2304a38-6939-4c4e-9483-558f589053d5

	measure 'Held-out Packs Protected (avg)' =
			CALCULATE (
			    AVERAGEX ( VALUES ( dim_scenario[scenario_id] ), [Packs Protected vs Do Nothing] ),
			    REMOVEFILTERS ( dim_scenario ), dim_scenario[split] = "held-out", REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5"
			)
		formatString: #,0
		lineageTag: 6eb59648-7739-4a93-b9ae-65ab23945a8a

	measure 'Held-out Cost Avoided' =
			CALCULATE (
			    SUMX ( VALUES ( dim_scenario[scenario_id] ), [Expected Cost Avoided] ),
			    REMOVEFILTERS ( dim_scenario ), dim_scenario[split] = "held-out", REMOVEFILTERS ( dim_policy ), dim_policy[policy_id] = "P5"
			)
		formatString: \$#,0
		lineageTag: ad5b15b9-6fdf-44a6-905b-13bb17a3ba38

	column Value
		dataType: string
		isHidden
		lineageTag: 02b88d98-b2ff-41ea-88b1-45e3e97272ac
		summarizeBy: none
		sourceColumn: Value

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Value = text], {})
				in
				    Source

	annotation PBI_ResultType = Table
