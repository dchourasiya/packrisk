	partition fact_inventory_trace = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_inventory_trace.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scenario_id", type text}, {"policy_id", type text}, {"realization_type", type text}, {"week", Int64.Type}, {"component_id", type text}, {"inventory_end", type number}, {"weeks_of_cover", type number}}, "en-US")
				in
