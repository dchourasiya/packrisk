				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scenario_id", type text}, {"policy_id", type text}, {"realization_type", type text}, {"week", Int64.Type}, {"component_id", type text}, {"inventory_end", type number}, {"weeks_of_cover", type number}}, "en-US")
