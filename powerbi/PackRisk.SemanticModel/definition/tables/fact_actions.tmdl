	partition fact_actions = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_actions.csv"), [Delimiter = ",", Columns = 7, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"scenario_id", type text}, {"policy_id", type text}, {"component_id", type text}, {"action", type text}, {"week", Int64.Type}, {"quantity", type number}, {"cost", type number}}, "en-US")
				in
