                                                                                                                      "value":  "- Expedite (air or team driver), extra inventory, approved alternate supplier.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Only incremental mitigation cost counts against the $250,000 budget.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "5. Decisions and evaluation",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "10pt",
                                                                                                                                        "fontWeight":  "bold",
                                                                                                                                        "color":  "#111827"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Static two-stage: all actions decided once at week 0.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Deterministic LP, Stochastic LP (100 samples), CVaR variant; oracle solves the same LP with perfect knowledge.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Planning (seed 42) and evaluation (seed 2027) samples are independent.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Penalty test: at $1K, $2K and $4K per lost pack, the smart plan beats doing nothing in 33 of 33 cases.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "6. Known limitations",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "10pt",
                                                                                                                                        "fontWeight":  "bold",
                                                                                                                                        "color":  "#111827"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Simulated operations; placeholder delays; calibration source is not battery parts.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- No rolling re-planning, no backlog recovery after capacity cuts, no MOQs or integer lots.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Heuristic baselines ignore the announcement; penalties are hypothetical.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
