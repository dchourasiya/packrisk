                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "1. Site, products, plan",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "10pt",
                                                                                                                                        "fontWeight":  "bold",
                                                                                                                                        "color":  "#111827"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- One hypothetical site, weekly buckets, 8-week horizon; SR (LFP) and LR (NMC) packs.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Plan SR 900 + LR 600 per week (12,000 packs); capacity 1,600/week.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Lost packs = plan - built at week 8; backlog pack-weeks measure how far and how long production runs behind.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "2. Supply",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "10pt",
                                                                                                                                        "fontWeight":  "bold",
                                                                                                                                        "color":  "#111827"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- 20 tier-1 suppliers, 6 tier-2 sources, 4 lanes, 50 components; just-in-time weekly POs.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Lots can be late, partial, quality-held, or cut by capacity loss / scrap; arrivals after week 8 ignored.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "3. Disruptions",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "10pt",
                                                                                                                                        "fontWeight":  "bold",
                                                                                                                                        "color":  "#111827"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Planner knows which disruption was announced, not its severity or duration.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- D1-D6: truth equals prior. H1-H5: held out, truth deliberately differs from prior.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             },
                                                                                             {
                                                                                                 "textRuns":  [
                                                                                                                  {
                                                                                                                      "value":  "- Lane and tier-2 shocks are correlated across exposed suppliers by default.",
                                                                                                                      "textStyle":  {
                                                                                                                                        "fontSize":  "8pt"
                                                                                                                                    }
                                                                                                                  }
                                                                                                              ]
                                                                                             }
                                                                                         ]
                                                                      }
                                                   }
